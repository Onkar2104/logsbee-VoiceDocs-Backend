APP_NAME=VoiceDocs API
API_V1_PREFIX=/api
ENVIRONMENT=development
DEBUG=true

# PostgreSQL (create the voicedocs database before starting the API)
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/voicedocs

# Logsbee User Management API
LOGSBEE_USER_API_BASE_URL=http://127.0.0.1:8000
LOGSBEE_USER_API_TIMEOUT_SECONDS=100

# Comma-separated frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Transcription provider: whisper (default) or indicconformer
TRANSCRIPTION_PROVIDER=whisper

# Local open-source Whisper transcription
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Optional AI4Bharat IndicConformer provider (Hindi: hi, Marathi: mr)
INDICCONFORMER_DEVICE=cpu

GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8080/api/google-drive/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=your_fernet_key
FRONTEND_APP_URL=http://localhost:5173
