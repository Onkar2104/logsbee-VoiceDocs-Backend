APP_NAME=VoiceDocs API
API_V1_PREFIX=/api
ENVIRONMENT=development
DEBUG=true

# PostgreSQL (create the voicedocs database before starting the API)
DATABASE_URL=

# Logsbee User Management API
LOGSBEE_USER_API_BASE_URL=
LOGSBEE_USER_API_TIMEOUT_SECONDS=100

CORS_ORIGINS=

# Whisper
WHISPER_MODEL_SIZE=large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=8
WHISPER_BATCH_SIZE=8

# Choose provider
# TRANSCRIPTION_PROVIDER=indicconformer
# TRANSCRIPTION_PROVIDER=indicwhisper
TRANSCRIPTION_PROVIDER=whisper

# indicwhisper
INDICWHISPER_DEVICE=
INDICWHISPER_MODEL_CACHE_DIR=

# IndicConformer
INDICCONFORMER_DEVICE=


GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_TOKEN_ENCRYPTION_KEY=

FRONTEND_APP_URL=