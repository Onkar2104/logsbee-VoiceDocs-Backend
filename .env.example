APP_NAME=VoiceDocs API
API_V1_PREFIX=/api
ENVIRONMENT=development
DEBUG=true

# PostgreSQL (create the voicedocs database before starting the API)
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/voicedocs

# Logsbee User Management API
LOGSBEE_USER_API_BASE_URL=http://localhost:8001
LOGSBEE_USER_API_TIMEOUT_SECONDS=100

# Comma-separated frontend origins allowed by CORS
CORS_ORIGINS=

# Local open-source Whisper transcription (model downloads on first use)
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
