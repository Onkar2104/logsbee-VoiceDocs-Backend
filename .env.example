APP_NAME=VoiceDocs API
API_V1_PREFIX=/api
ENVIRONMENT=development
DEBUG=true

# PostgreSQL (create the voicedocs database before starting the API)
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/voicedocs

# Logsbee User Management API
LOGSBEE_USER_API_BASE_URL=http://127.0.0.1:8000
LOGSBEE_USER_API_TIMEOUT_SECONDS=100

# Comma-separated frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local open-source Whisper transcription
# Select the backend transcription engine: whisper or indicconformer
TRANSCRIPTION_PROVIDER=whisper

# Whisper settings (model downloads on first use)
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=8
WHISPER_BATCH_SIZE=8

# IndicConformer settings (only required when TRANSCRIPTION_PROVIDER=indicconformer)
# Supported language codes: hi (Hindi), mr (Marathi)
INDICCONFORMER_DEVICE=cpu

GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/google-drive/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=your_fernet_key
FRONTEND_APP_URL=http://localhost:5173
